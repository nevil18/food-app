# stage 1: build
FROM node:22 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# stage 2: serve
FROM nginx:stable-alpine-slim AS production

# 1. Always pull the latest patched Alpine packages at build time
# 2. Remove curl/libcurl (not needed to serve static files)
# 3. Fail the build if nginx is broken by the changes
RUN apk upgrade --no-cache \
 && (apk del --no-cache curl libcurl || true) \
 && nginx -v

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
